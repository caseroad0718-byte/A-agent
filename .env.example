# Copy to .env locally, or set these as GitHub Secrets / cloud env vars.
# Never commit a real key.
A_STOCK_API_KEY=replace-with-random-bearer-token

# DeepSeek OpenAI-compatible chat API.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_STRONG=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
# Legacy fallback for older scripts; keep this on the strong model, not Flash.
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional data and notification providers.
TUSHARE_TOKEN=
SERVERCHAN_SENDKEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime knobs.
A_STOCK_DB_PATH=data/a_stock_system.sqlite
A_STOCK_TRADING_ENABLED=false
A_STOCK_USE_FIXTURE_DATA=false
A_STOCK_PUBLIC_BASE_URL=

# Optional local Hermes bridge. Keep false for cloud deployments unless Hermes CLI is present.
A_STOCK_ENABLE_HERMES_BRIDGE=false
HERMES_AGENT_CLI=C:/Users/Road7/AppData/Local/hermes/hermes-agent/venv/Scripts/hermes.exe
